{
  "id": "/",
  "name": "Owlet",
  "short_name": "Owlet",
  "description": "Clip, highlight and cite sources with your study group.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f6fa",
  "theme_color": "#102b5c",
  "categories": ["education", "productivity"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/clip",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Save a link", "short_name": "Save link", "url": "/clip", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
