{
  "manifest_version": 3,
  "name": "Owlet",
  "version": "0.2.0",
  "minimum_chrome_version": "111",
  "description": "Clip web pages into your Owlet research library with AI summaries and citations.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clip to Owlet",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.yourdomain.com/*"],
  "content_scripts": [
    {
      "matches": ["https://app.yourdomain.com/*"],
      "js": ["pageHook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.yourdomain.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}